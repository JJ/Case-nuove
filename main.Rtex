library(forecast)
# library(anomalize)

# 1. Detect outliers directly on the annual time series object
marriage_ts <- ts(marriages_by_year$matrimonies, start = min(marriages_by_year$year), frequency = 1)
outliers <- tsoutliers(marriage_ts)
# print(outliers)

# 2. Decompose into Trend + Remainder manually using robust LOESS smoothing
marriages_by_year <- marriages_by_year %>%
  mutate(
    trend = predict(loess(matrimonies ~ year, span = 0.3)),
    remainder = matrimonies - trend,
    # Flag anomalies using Median Absolute Deviation (MAD) on residuals
    mad_val = mad(remainder),
    is_anomaly = abs(remainder - median(remainder)) > (3 * mad_val)
  )

# 3. Filter and view the flagged anomalous years
anomalous_years <- marriages_by_year %>%
  filter(is_anomaly) %>%
  select(year, matrimonies, trend, remainder)

# 4. Visualize the robust trend and detected anomalies
